// Local development. Staging and production configs live with the operator.
{
  "name": "pokerchips",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "TableCell" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableCell"] }],
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  }
}
